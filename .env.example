# Proxmox VE Connection
PROXMOX_HOST=https://your-proxmox-ip:8006
# Format: user@realm!tokenname (e.g., root@pam!mcp-hub or mcp@pve!homelab)
PROXMOX_TOKEN_ID=
# UUID secret shown once when creating the API token in Proxmox VE
PROXMOX_TOKEN_SECRET=
# Set to true if your Proxmox host has a valid CA-signed TLS certificate
PROXMOX_VERIFY_SSL=false
# Request timeout in seconds
PROXMOX_TIMEOUT=30

# Safety & Guardrails
# Options: read_only | safe | full
#   read_only: Blocks all mutating actions (start/stop/create/delete)
#   safe:      Allows monitoring, power, VM/LXC creation, snapshots & backups; blocks destructive deletes unless ALLOW_DESTRUCTIVE=true
#   full:      Allows all operations including VM/LXC deletion (still requires explicit confirm=true)
SAFETY_MODE=safe
ALLOW_DESTRUCTIVE=false

# Demo / Preview Mode
# Set to true to explore the WebUI and MCP tools with realistic simulated homelab data before adding your API key
PROXMOX_DEMO_MODE=false

# WebUI & Streamable HTTP MCP Server
WEBUI_HOST=0.0.0.0
WEBUI_PORT=8806

# Optional SSH (enables 1-click direct Community-Scripts deployment on Proxmox host)
PROXMOX_SSH_USER=root
PROXMOX_SSH_PORT=22
PROXMOX_SSH_KEY_PATH=

# Optional Dell iDRAC Redfish API (wattage, temps, fans, PSUs)
IDRAC_HOST=
IDRAC_USER=root
IDRAC_PASSWORD=
ELECTRICITY_RATE_KWH=0.26
CURRENCY_SYMBOL=£

# Optional Bare-Metal TrueNAS Host (read-only monitoring via JSON-RPC 2.0 WebSocket / REST v2)
TRUENAS_HOST=
TRUENAS_API_KEY=
TRUENAS_VERIFY_SSL=false
